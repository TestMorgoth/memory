import { COPY } from '../../config/copy.config';

type Props = {
  onStart: () => void;
};

export function RulesPanel({ onStart }: Props) {
  return (
    <div className="mx-auto flex max-w-4xl flex-col gap-8 rounded-kiosk bg-white/10 p-10 text-white shadow-kiosk">
      <h2 className="text-5xl font-black">Come si gioca</h2>
      <ul className="space-y-4 text-2xl">
        {COPY.rules.map((rule) => (
          <li key={rule}>• {rule}</li>
        ))}
      </ul>
      <button
        type="button"
        onClick={onStart}
        className="mt-4 rounded-full bg-brand-blue px-8 py-4 text-2xl font-bold text-white"
      >
        {COPY.ctaStart}
      </button>
    </div>
  );
}