import type { BoardCard } from '../../types/cards';

type Props = {
  card: BoardCard;
  disabled: boolean;
  onClick: (boardId: string) => void;
};

export function MemoryCard({ card, disabled, onClick }: Props) {
  const isFaceUp = card.isFlipped || card.isMatched;

  return (
    <button
      type="button"
      aria-label={card.title}
      disabled={disabled || card.isMatched}
      onClick={() => onClick(card.boardId)}
      className="relative aspect-[3/4] w-full rounded-kiosk border border-white/15 bg-white/10 shadow-kiosk"
    >
      <div className="absolute inset-0 overflow-hidden rounded-kiosk">
        {isFaceUp ? (
          <img src={card.image} alt={card.title} className="h-full w-full object-cover" draggable={false} />
        ) : (
          <img src="/assets/cards/back/card-back.webp" alt="Card back" className="h-full w-full object-cover" draggable={false} />
        )}
      </div>
    </button>
  );
}